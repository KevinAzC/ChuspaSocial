<?xml version="1.0" encoding="UTF-8"?>
<XMLDB PATH="local/chuspasocial/db" VERSION="20261018" COMMENT="XMLDB file for Moodle">
    <TABLES>
        <TABLE NAME="local_chuspasocial_reaction"
            COMMENT="Reacciones de tipo me gusta sobre las publicaciones">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" />
                <FIELD NAME="postid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"
                    SEQUENCE="false" COMMENT="Id de la publicacion reaccionada" />
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"
                    SEQUENCE="false" COMMENT="Id del usuario que reacciona" />
                <FIELD NAME="type" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="like"
                    SEQUENCE="false" COMMENT="Tipo de reaccion" />
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"
                    SEQUENCE="false" COMMENT="Marca de tiempo de creacion" />
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id" />
                <KEY NAME="postid" TYPE="foreign" FIELDS="postid" REFTABLE="local_chuspasocial_post" REFFIELDS="id"/>
                <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="postid_userid" UNIQUE="true" FIELDS="postid, userid"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="local_chuspasocial_comment" COMMENT="Comentarios sobre las publicaciones">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" />
                <FIELD NAME="postid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"
                    SEQUENCE="false" COMMENT="Id de la publicacion comentada" />
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"
                    SEQUENCE="false" COMMENT="Id del usuario que comenta" />
                <FIELD NAME="content" TYPE="text" NOTNULL="true" SEQUENCE="false"
                    COMMENT="Contenido del comentario" />
                <FIELD NAME="contentformat" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0"
                    SEQUENCE="false" COMMENT="Formato del contenido" />
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"
                    SEQUENCE="false" COMMENT="Marca de tiempo de creacion" />
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"
                    SEQUENCE="false" COMMENT="Marca de tiempo de modificacion" />
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id" />
            </KEYS>
        </TABLE>
        <TABLE NAME="local_chuspasocial_post" COMMENT="Publicaciones de ChuspaSocial">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Usuario que crea la publicacion"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Curso asociado; 0 indica muro general"/>
                <FIELD NAME="type" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="post" SEQUENCE="false" COMMENT="Tipo de publicacion"/>
                <FIELD NAME="content" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Contenido de la publicacion"/>
                <FIELD NAME="contentformat" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Formato del contenido"/>
                <FIELD NAME="hidden" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Indica si la publicacion esta oculta"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Marca de tiempo de creacion"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Marca de tiempo de modificacion"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_chuspasocial_lstcourse" COMMENT="Vinculos entre anuncio de libro y materia">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="listingid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Id del anuncio de libro"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Id de la materia"/>
            </FIELDS>
            <KEYS>
              <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_chuspasocial_report" COMMENT="Reportes de contenido de ChuspaSocial">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="itemtype" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="Tipo de contenido reportado"/>
                <FIELD NAME="itemid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Identificador del contenido reportado"/>
                <FIELD NAME="reporterid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Usuario que realiza el reporte"/>
                <FIELD NAME="reason" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Motivo del reporte"/>
                <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="open" SEQUENCE="false" COMMENT="Estado del reporte"/>
                <FIELD NAME="resolvedby" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Usuario que resuelve el reporte"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Marca de tiempo de creación"/>
                <FIELD NAME="timeresolved" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Marca de tiempo de resolución"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>
    </TABLES>
</XMLDB>
